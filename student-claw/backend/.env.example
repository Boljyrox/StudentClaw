# ============================================================================
#  Student Claw — BACKEND environment (.env)
#  Copy to `.env` and fill in.  `cp .env.example .env`
#
#  Secrets marked (SHARED) MUST be byte-for-byte identical to the frontend .env.
#  Generate any "openssl rand -hex 32" value with:  openssl rand -hex 32
# ============================================================================

# ── Database (PostgreSQL, async driver) ─────────────────────────────────────
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://student_claw:student_claw@localhost:5432/student_claw

# ── Agnes AI (chat + embeddings, OpenAI-compatible endpoint) ────────────────
AGNES_AI_API_KEY=sk-
AGNES_AI_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_CHAT_MODEL=agnes-2.0-flash
AGNES_EMBED_MODEL=agnes-embeddings
EMBED_DIM=1536

# ── OpenRouter fallback (Requirement 2 — used when Agnes fails/times out) ────
# Get a key at https://openrouter.ai/keys. Leave blank to disable the fallback.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Three DIFFERENT roles — keep them separate. Prices are $ per 1M tokens
# (in/out) at the time of writing; check openrouter.ai/models for current.
#
# 1. Text fallback: used when Agnes is down. Must be FAST and non-reasoning —
#    a reasoning model burns tokens "thinking" before every casual reply.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite               # $0.10 / $0.40
# 2. Reasoning: only for requests app/ai/routing.py judges complex. Here a
#    reasoning model is exactly what you want, and this is the cheapest one.
OPENROUTER_REASONING_MODEL=deepseek/deepseek-v4-flash       # $0.06 / $0.12
# 3. Vision: receipt photos and scanned PDFs. MUST accept image input —
#    DeepSeek's text models do not, so this one is a Qwen/Gemini model.
OPENROUTER_VISION_MODEL=qwen/qwen3-vl-32b-instruct          # $0.10 / $0.42

# --- Long-term group memory ---------------------------------------------
# Facts Agnes remembers expire after this many days.
MEMORY_RETENTION_DAYS=30

# --- OneMap SG (/meetpoint) ---------------------------------------------
# Geocoding (postal code -> coordinates) is public and needs no credentials.
# Public-transport ROUTING does: supply either a token, or an email/password
# pair to mint one. Without these, /meetpoint still works but sends a map
# link instead of step-by-step directions.
ONEMAP_BASE_URL=https://www.onemap.gov.sg
ONEMAP_TOKEN=
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# ── Qdrant (vector DB) ──────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Redis (job queue + SSE pub/sub) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MinIO (S3-compatible file storage) ──────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# ── Telegram bot ────────────────────────────────────────────────────────────
# Token from @BotFather. Disable the bot's group-privacy mode so it can read
# group messages (BotFather → /setprivacy → Disable).
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-botfather-token
TELEGRAM_BOT_USERNAME=your_bot_username
# Webhook secret (any random string). Required even in polling mode.
TELEGRAM_WEBHOOK_SECRET=
# Production webhook only — leave EMPTY for local polling-mode development.
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_PATH=/bot/webhook

# ── Linkage key derivation (Telegram ↔ web) ─────────────────────────────────
PROJECT_KEY_HMAC_SECRET=replace-with-openssl-rand-hex-32

# ── Auth / JWT (SHARED with frontend) ───────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── At-rest encryption for Google refresh tokens (SHARED with frontend) ─────
# Exactly 32 bytes → 64 hex chars.  openssl rand -hex 32
ENCRYPTION_KEY=

# ── Google Calendar OAuth2 (SHARED client with frontend) ────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── CORS (optional; comma-separated origins for direct browser access) ──────
CORS_ORIGINS=http://localhost:3000

# ── SUTD_Admin diagnostic dashboard (Requirement 1) ─────────────────────────
# Shared secret gating /admin/* endpoints and the /sutd-admin web dashboard.
# Use the SAME value in the frontend .env.  openssl rand -hex 32
ADMIN_API_TOKEN=replace-with-openssl-rand-hex-32

# ── Embeddings (Agnes has no embeddings endpoint → local model by default) ──
# "fastembed" (local, no API, 384-dim) or "agnes". Switching providers
# auto-recreates Qdrant collections at the new dimension.
EMBED_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
